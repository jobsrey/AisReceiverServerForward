# ============================================
# AIS RECEIVER SERVER CONFIGURATION
# ============================================
# Copy this file to .env and adjust values

# ============================================
# PORT RANGE CONFIGURATION
# ============================================
# Range of ports to listen for AIS data
# Each port represents a different AIS device/stream
PORT_START=5300
PORT_END=12000

# ============================================
# SERVER CONFIGURATION
# ============================================
# Host to bind (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Enable verbose logging (true/false)
VERBOSE_LOGGING=true

# Log statistics interval in seconds
STATS_INTERVAL=60

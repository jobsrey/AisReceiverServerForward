# ============================================
# AIS RECEIVER SERVER CONFIGURATION
# ============================================
# Copy this file to .env and adjust values

# ============================================
# PORT RANGE CONFIGURATION
# ============================================
# Range of ports to listen for AIS data
# Each port represents a different AIS device/stream
PORT_START=4000
PORT_END=5000

# ============================================
# SERVER CONFIGURATION
# ============================================
# Host to bind (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Health check port
HEALTH_PORT=3000

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable verbose logging (true/false)
VERBOSE_LOGGING=false

# Log statistics interval in seconds
STATS_INTERVAL=60

# ============================================
# CONNECTION REFRESH
# ============================================
# Auto-disconnect connections after this interval (in minutes)
# Set to 0 to disable auto-disconnect
# Useful for forcing clients to reconnect periodically
CONNECTION_REFRESH_INTERVAL=30

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=production
